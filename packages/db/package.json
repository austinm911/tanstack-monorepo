{
	"name": "@repo/db",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist node_modules .turbo",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check --write",
		"test": "bun test",
		"generate": "drizzle-kit generate",
		"check": "drizzle-kit check",
		"push": "bun --env-file=../../.env drizzle-kit push",
		"migrate": "drizzle-kit migrate",
		"outdated": "bun outdated"
	},
	"dependencies": {
		"drizzle-orm": "^0.36.4",
		"drizzle-zod": "^0.5.1",
		"postgres": "^3.4.5",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"drizzle-kit": "^0.24.2",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2"
	}
}
